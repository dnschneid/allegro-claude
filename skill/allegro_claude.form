# Allegro-Claude dialog definition

FILE_TYPE=FORM_DEFN VERSION=2

FORM FIXED_FONT
FIXED
PORT 80 60
HEADER "Claude AI Assistant"

DEFAULT send

POPUP <MODE>"Auto""auto","Manual""manual".

TILE

FIELD chatlog
FLOC 0 0
STRFILLIN 46 65536
FSIZE 46 28
INFO_ONLY
ENDFIELD

TEXT "Ready"
FLOC 0 29
INFO statuslabel 33
OPTIONS border
ENDTEXT

TEXT "Lines:"
FLOC 34 29
ENDTEXT

FIELD loglines
FLOC 35 29
LONGFILLIN 5 5
MIN 1
MAX 99
ENDFIELD

FIELD userinput
FLOC 0 31
STRFILLIN 34 65536
ENDFIELD

FIELD send
FLOC 34 31
MENUBUTTON "Send" 12 2
ENDFIELD

FIELD record
FLOC 0 33
MENUBUTTON "Record" 12 2
ENDFIELD

FIELD mode
FLOC 12 33
ENUMSET 3
POP "MODE"
ENDFIELD

FIELD session
FLOC 22 33
MENUBUTTON "Session..." 12 2
ENDFIELD

FIELD fulllog
FLOC 34 33
MENUBUTTON "Full Log" 12 2
ENDFIELD

# NOTE: none of these seem to take effect other than to enable resizing.
#       the detailed parameters are just ignored
FLEX chatlog 0 0 1 1
FLEX statuslabel 0 1 1 0
FLEX userinput 0 1 1 0
FLEX send 1 1 0 0
FLEX mode 0 1 0 0
FLEX session 1 1 0 0
FLEXMODE StandButtons

ENDTILE

ENDFORM
