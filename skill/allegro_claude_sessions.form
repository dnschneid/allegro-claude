# Session picker dialog: list of sessions + model dropdown for new
# sessions + Rename / Delete / Restore / Cancel.

FILE_TYPE=FORM_DEFN VERSION=2

FORM FIXED_FONT
FIXED
PORT 80 26
HEADER "Claude Sessions"

DEFAULT restore

TILE

FIELD sessionlist
FLOC 0 0
LIST "" 80 18
FSIZE 80 18
ENDFIELD

TEXT "Model (new sessions):"
FLOC 0 19
ENDTEXT

FIELD modelchoice
FLOC 22 19
LIST "" 56 1
FSIZE 56 4
ENDFIELD

FIELD rename
FLOC 0 23
MENUBUTTON "Rename selected session" 28 2
ENDFIELD

FIELD delete
FLOC 28 23
MENUBUTTON "Delete selected session" 28 2
ENDFIELD

FIELD restore
FLOC 69 23
MENUBUTTON "Open" 11 2
ENDFIELD

FLEX sessionlist 0 0 1 1
FLEX modelchoice 0 1 1 0
FLEX rename 0 1 0 0
FLEX delete 0 1 0 0
FLEX restore 1 1 0 0
FLEX cancel 1 1 0 0
FLEXMODE StandButtons

ENDTILE

ENDFORM
